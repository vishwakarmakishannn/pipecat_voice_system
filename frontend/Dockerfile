# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

ARG VITE_STUN_URLS
ARG VITE_TURN_URLS
ARG VITE_TURN_USERNAME
ARG VITE_TURN_CREDENTIAL
ARG VITE_API_BASE
ARG VITE_AUDIO_ECHO_CANCELLATION
ARG VITE_AUDIO_NOISE_SUPPRESSION
ARG VITE_AUDIO_AUTO_GAIN_CONTROL
ARG VITE_LOCAL_SPEECH_LEVEL_THRESHOLD
ARG VITE_WEBRTC_CONNECT_TIMEOUT_MS
ARG VITE_MAX_TRANSCRIPT_ITEMS
ENV VITE_STUN_URLS=$VITE_STUN_URLS
ENV VITE_TURN_URLS=$VITE_TURN_URLS
ENV VITE_TURN_USERNAME=$VITE_TURN_USERNAME
ENV VITE_TURN_CREDENTIAL=$VITE_TURN_CREDENTIAL
ENV VITE_API_BASE=$VITE_API_BASE
ENV VITE_AUDIO_ECHO_CANCELLATION=$VITE_AUDIO_ECHO_CANCELLATION
ENV VITE_AUDIO_NOISE_SUPPRESSION=$VITE_AUDIO_NOISE_SUPPRESSION
ENV VITE_AUDIO_AUTO_GAIN_CONTROL=$VITE_AUDIO_AUTO_GAIN_CONTROL
ENV VITE_LOCAL_SPEECH_LEVEL_THRESHOLD=$VITE_LOCAL_SPEECH_LEVEL_THRESHOLD
ENV VITE_WEBRTC_CONNECT_TIMEOUT_MS=$VITE_WEBRTC_CONNECT_TIMEOUT_MS
ENV VITE_MAX_TRANSCRIPT_ITEMS=$VITE_MAX_TRANSCRIPT_ITEMS

COPY package*.json ./
RUN npm install

COPY . .
RUN npm run build

# Serve stage using nginx
FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
