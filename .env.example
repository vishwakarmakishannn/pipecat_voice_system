# Copy to .env for local development. Never commit real credential values.
# Production deployments must inject secrets through the deployment platform.

JWT_SECRET=
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voice_system
ALLOWED_ORIGINS=http://localhost:5173
VITE_API_BASE=http://localhost:7860

LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=
GOOGLE_API_KEY=
GOOGLE_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3-general
DEEPGRAM_STT_LANGUAGE=en
DEEPGRAM_STT_NUMERALS=true
DEEPGRAM_STT_SMART_FORMAT=true

TTS_PROVIDER=deepgram
DEEPGRAM_VOICE_ID=
CARTESIA_API_KEY=
CARTESIA_MODEL=
CARTESIA_VOICE_ID=

WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=
VOICE_TOOL_FILLER_ENABLED=true
VOICE_TOOL_FILLER_DELAY_MS=0
VOICE_TOOL_FILLER_TEXT=Let me look that up for you.

TURN_STOP_STRATEGY=smart_turn
VAD_CONFIDENCE=0.7
VAD_START_SECS=0.15
VAD_STOP_SECS=0.15
VAD_MIN_VOLUME=0.5
SMART_TURN_STOP_SECS=0.7
SMART_TURN_PRE_SPEECH_MS=300
SMART_TURN_MAX_DURATION_SECS=8

MSWIPE_ISSUE_CONTRACT_VERSION=demo-v1-unverified
MSWIPE_KNOWLEDGE_ENABLED=true
MSWIPE_KNOWLEDGE_ALLOWED_DOMAINS=mswipe.com
MSWIPE_KNOWLEDGE_EMBEDDING_PROVIDER=google
MSWIPE_KNOWLEDGE_EMBEDDING_MODEL=
MSWIPE_KNOWLEDGE_EMBEDDING_DIMENSION=768
MSWIPE_KNOWLEDGE_QUERY_INFLIGHT_MAX=128
MSWIPE_KNOWLEDGE_EMBEDDING_CIRCUIT_FAILURES=2
MSWIPE_KNOWLEDGE_EMBEDDING_CIRCUIT_COOLDOWN_SECONDS=30
MSWIPE_KNOWLEDGE_RESPECT_ROBOTS=true
MSWIPE_KNOWLEDGE_CHUNK_POLICY_VERSION=structure-v2

S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
